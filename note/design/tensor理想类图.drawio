                <mxCell id="alloc" value="&lt;b style=&quot;font-size:12px&quot;&gt;Allocator&lt;/b&gt;  &lt;font color=&quot;#666666&quot;&gt;«interface»&lt;/font&gt;&lt;br&gt;&lt;font color=&quot;#666666&quot;&gt;include/tensor/allocator.h&lt;/font&gt;&lt;hr size=&quot;1&quot;/&gt;+ kAlignment : size_t&lt;br&gt;+ allocate(nbytes : size_t) : DataPtr" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=6;spacingTop=2;fontSize=10;fillColor=#dae8fc;strokeColor=#6c8ebf;" parent="1" vertex="1">
                    <mxGeometry x="580" y="940" width="300" height="80" as="geometry"/>
                </mxCell>
                <mxCell id="cpualloc" value="&lt;b style=&quot;font-size:12px&quot;&gt;CPUAllocator&lt;/b&gt;&lt;br&gt;&lt;font color=&quot;#666666&quot;&gt;src/memory/&lt;/font&gt;&lt;hr size=&quot;1&quot;/&gt;+ allocate()&lt;br&gt;&amp;nbsp;&amp;nbsp;带对齐的 malloc" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=6;spacingTop=2;fontSize=10;fillColor=#fff2cc;strokeColor=#d6b656;" parent="1" vertex="1">
                    <mxGeometry x="580" y="1060" width="145" height="85" as="geometry"/>
                </mxCell>
                <mxCell id="cudaalloc" value="&lt;b style=&quot;font-size:12px&quot;&gt;CUDAAllocator&lt;/b&gt;&lt;br&gt;&lt;font color=&quot;#666666&quot;&gt;src/memory/&lt;/font&gt;&lt;hr size=&quot;1&quot;/&gt;+ allocate()&lt;br&gt;&amp;nbsp;&amp;nbsp;cudaMalloc&lt;br&gt;&amp;nbsp;&amp;nbsp;以后：显存池&lt;br&gt;&amp;nbsp;&amp;nbsp;删除器记录 stream" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=6;spacingTop=2;fontSize=10;fillColor=#fff2cc;strokeColor=#d6b656;" parent="1" vertex="1">
                    <mxGeometry x="735" y="1060" width="145" height="115" as="geometry"/>
                </mxCell>
                <mxCell id="runtime" value="&lt;b style=&quot;font-size:12px&quot;&gt;内存管理&lt;/b&gt;  &lt;font color=&quot;#666666&quot;&gt;一组函数，不是类&lt;/font&gt;&lt;br&gt;&lt;font color=&quot;#666666&quot;&gt;src/memory/memory.h&lt;/font&gt;&lt;hr size=&quot;1&quot;/&gt;+ GetAllocator(device) : Allocator*&lt;br&gt;+ CopyBytes(dst, src, nbytes)：主机 ↔ 设备&lt;br&gt;调用方：Tensor 构造、ops/copy&lt;br&gt;以后：显存池时分配器移到 src/cuda/，并记录 stream" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=6;spacingTop=2;fontSize=10;fillColor=#fff2cc;strokeColor=#d6b656;" parent="1" vertex="1">
                    <mxGeometry x="1100" y="940" width="340" height="125" as="geometry"/>
                </mxCell>
                <mxCell id="dataptr" value="&lt;b style=&quot;font-size:12px&quot;&gt;DataPtr&lt;/b&gt;&lt;br&gt;&lt;font color=&quot;#666666&quot;&gt;include/tensor/allocator.h&lt;/font&gt;&lt;hr size=&quot;1&quot;/&gt;- data_ : void*&lt;br&gt;- device_ : Device&lt;br&gt;- deleter_：删除器 + 上下文&lt;hr size=&quot;1&quot;/&gt;+ get() / device()" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=6;spacingTop=2;fontSize=10;fillColor=#dae8fc;strokeColor=#6c8ebf;" parent="1" vertex="1">
                    <mxGeometry x="140" y="1290" width="300" height="115" as="geometry"/>
                </mxCell>
                <mxCell id="device" value="&lt;b style=&quot;font-size:12px&quot;&gt;Device&lt;/b&gt;&lt;br&gt;&lt;font color=&quot;#666666&quot;&gt;include/tensor/device.h&lt;/font&gt;&lt;hr size=&quot;1&quot;/&gt;- kCPU / kCUDA&lt;br&gt;由 DataPtr 记录" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=6;spacingTop=2;fontSize=10;fillColor=#dae8fc;strokeColor=#6c8ebf;" parent="1" vertex="1">
                    <mxGeometry x="740" y="1290" width="180" height="85" as="geometry"/>
                </mxCell>
                <mxCell id="scalar" value="&lt;b style=&quot;font-size:12px&quot;&gt;Scalar&lt;/b&gt;&lt;br&gt;&lt;font color=&quot;#666666&quot;&gt;include/tensor/scalar.h&lt;/font&gt;&lt;hr size=&quot;1&quot;/&gt;- 数值 + 类别&lt;br&gt;+ to&lt;T&gt;()" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=6;spacingTop=2;fontSize=10;fillColor=#dae8fc;strokeColor=#6c8ebf;" parent="1" vertex="1">
                    <mxGeometry x="940" y="1290" width="180" height="85" as="geometry"/>
                </mxCell>
                <mxCell id="node" value="&lt;b style=&quot;font-size:12px&quot;&gt;AutogradNode&lt;/b&gt;  &lt;font color=&quot;#666666&quot;&gt;«abstract»&lt;/font&gt;&lt;br&gt;&lt;font color=&quot;#666666&quot;&gt;include/autograd.h&lt;/font&gt;&lt;hr size=&quot;1&quot;/&gt;+ inputs : vector&lt;Tensor&gt;&lt;br&gt;+ backward(output_grad) : vector&lt;Tensor&gt;" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=6;spacingTop=2;fontSize=10;fillColor=#ffe6cc;strokeColor=#d79b00;" parent="1" vertex="1">
                    <mxGeometry x="560" y="90" width="300" height="90" as="geometry"/>
                </mxCell>
                <mxCell id="meta" value="&lt;b style=&quot;font-size:12px&quot;&gt;AutogradMetadata&lt;/b&gt;&lt;br&gt;&lt;font color=&quot;#666666&quot;&gt;include/autograd.h&lt;/font&gt;&lt;hr size=&quot;1&quot;/&gt;- requires_grad_ : bool&lt;br&gt;- grad_node_ : shared_ptr&lt;AutogradNode&gt;&lt;br&gt;- grad_ : optional&lt;Tensor&gt;" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=6;spacingTop=2;fontSize=10;fillColor=#ffe6cc;strokeColor=#d79b00;" parent="1" vertex="1">
                    <mxGeometry x="560" y="205" width="300" height="100" as="geometry"/>
                </mxCell>
                <mxCell id="entry" value="&lt;b style=&quot;font-size:12px&quot;&gt;算子入口  mul(lhs, rhs)&lt;/b&gt;&lt;br&gt;&lt;font color=&quot;#666666&quot;&gt;src/ops/elementwise/elementwise.cpp&lt;/font&gt;&lt;hr size=&quot;1&quot;/&gt;1 校验 shape / dtype / device&lt;br&gt;2 建输出 Tensor，分配走 Allocator&lt;br&gt;3 按 device 调 CPU 或 CUDA 后端&lt;br&gt;4 建图时创建 MulNode，挂到输出" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=6;spacingTop=2;fontSize=10;fillColor=#e1d5e7;strokeColor=#9673a6;" parent="1" vertex="1">
                    <mxGeometry x="1100" y="90" width="340" height="120" as="geometry"/>
                </mxCell>
                <mxCell id="kernels" value="&lt;b style=&quot;font-size:12px&quot;&gt;CUDALayout&lt;/b&gt;  &lt;font color=&quot;#666666&quot;&gt;src/ops/common/cuda_layout.h&lt;/font&gt;&lt;br&gt;+ dim : int&lt;br&gt;+ shape : int64_t[kMaxDim]&lt;br&gt;+ stride : int64_t[kMaxDim]&lt;hr size=&quot;1&quot;/&gt;&lt;b style=&quot;font-size:12px&quot;&gt;kernels.h&lt;/b&gt;  &lt;font color=&quot;#666666&quot;&gt;入口与后端的私有声明&lt;/font&gt;&lt;br&gt;+ MulCPU(a, b, out, shape, stride, dim, dtype)&lt;br&gt;+ MulCUDA(a, b, out, 3 个 CUDALayout, dtype)" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=6;spacingTop=2;fontSize=10;fillColor=#e1d5e7;strokeColor=#9673a6;" parent="1" vertex="1">
                    <mxGeometry x="1100" y="230" width="340" height="125" as="geometry"/>
                </mxCell>
                <mxCell id="backends" value="&lt;b style=&quot;font-size:12px&quot;&gt;cpu.cpp / cuda.cu&lt;/b&gt;  &lt;font color=&quot;#666666&quot;&gt;后端&lt;/font&gt;&lt;hr size=&quot;1&quot;/&gt;- 只收到首地址、布局、dtype&lt;br&gt;- 不 include Tensor，不碰 Storage" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=6;spacingTop=2;fontSize=10;fillColor=#e1d5e7;strokeColor=#9673a6;" parent="1" vertex="1">
                    <mxGeometry x="1100" y="380" width="340" height="75" as="geometry"/>
                </mxCell>
                <mxCell id="mulnode" value="&lt;b style=&quot;font-size:12px&quot;&gt;MulNode&lt;/b&gt;&lt;br&gt;&lt;font color=&quot;#666666&quot;&gt;src/ops/elementwise/nodes.h&lt;/font&gt;&lt;hr size=&quot;1&quot;/&gt;- input_versions_ : uint64[2]&lt;br&gt;+ backward(output_grad) : vector&lt;Tensor&gt;" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=6;spacingTop=2;fontSize=10;fillColor=#e1d5e7;strokeColor=#9673a6;" parent="1" vertex="1">
                    <mxGeometry x="1100" y="475" width="340" height="75" as="geometry"/>
                </mxCell>
                <mxCell id="legend" value="&lt;b style=&quot;font-size:12px&quot;&gt;图例&lt;/b&gt;&lt;hr size=&quot;1&quot;/&gt;&lt;b&gt;箭头从使用方指向被使用方&lt;/b&gt;&lt;br&gt;&lt;br&gt;◆ 实心菱形：值成员，独占&lt;br&gt;◇ 空心菱形：shared_ptr 共享持有&lt;br&gt;虚线箭头：只使用，不持有&lt;br&gt;空心三角：继承&lt;hr size=&quot;1&quot;/&gt;&lt;b&gt;颜色 = 所在目录&lt;/b&gt;&lt;br&gt;&lt;font color=&quot;#6c8ebf&quot;&gt;■&lt;/font&gt; 蓝色：include/tensor&lt;br&gt;&lt;font color=&quot;#82b366&quot;&gt;■&lt;/font&gt; 绿色：src/tensor&lt;br&gt;&lt;font color=&quot;#d79b00&quot;&gt;■&lt;/font&gt; 橙色：autograd&lt;br&gt;&lt;font color=&quot;#9673a6&quot;&gt;■&lt;/font&gt; 紫色：src/ops&lt;br&gt;&lt;font color=&quot;#d6b656&quot;&gt;■&lt;/font&gt; 黄色：src/memory" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=6;spacingTop=2;fontSize=10;fillColor=#f5f5f5;strokeColor=#666666;" parent="1" vertex="1">
                    <mxGeometry x="1525" y="90" width="285" height="300" as="geometry"/>
                </mxCell>
                <mxCell id="rules" value="&lt;b style=&quot;font-size:12px&quot;&gt;读图要点&lt;/b&gt;&lt;hr size=&quot;1&quot;/&gt;&lt;b&gt;1 依赖只向下&lt;/b&gt;&lt;br&gt;下层不 include 上层。&lt;br&gt;&lt;br&gt;&lt;b&gt;2 分配只有一个入口&lt;/b&gt;&lt;br&gt;只有 Tensor(shape, dtype, device) 调 GetAllocator。TensorImpl 只接收现成的 Storage，不认识 Allocator。&lt;br&gt;&lt;br&gt;&lt;b&gt;3 Tensor 和 Autograd 互相依赖&lt;/b&gt;&lt;br&gt;AutogradNode 持有 inputs，TensorImpl 持有 autograd_meta_，靠前置声明解开。&lt;br&gt;&lt;br&gt;&lt;b&gt;4 后端不认识 Tensor&lt;/b&gt;&lt;br&gt;kernels.h 只传首地址、布局、dtype。布局按值传入，所以 TensorImpl 没有设备副本。&lt;br&gt;&lt;br&gt;&lt;b&gt;5 Tensor 不持有 stream&lt;/b&gt;&lt;br&gt;做显存池时，分配器要记录每块内存在哪些 stream 上用过，届时移到 src/cuda/。" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=6;spacingTop=2;fontSize=10;fillColor=#f5f5f5;strokeColor=#666666;" vertex="1" parent="1">
                    <mxGeometry x="1525" y="620" width="285" height="785" as="geometry"/>
                </mxCell>
