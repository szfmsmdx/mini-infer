                <mxCell id="tensor" value="&lt;b style=&quot;font-size:12px&quot;&gt;Tensor&lt;/b&gt;  &lt;font color=&quot;#666666&quot;&gt;句柄&lt;/font&gt;&lt;br&gt;&lt;font color=&quot;#666666&quot;&gt;include/tensor/tensor.h&lt;/font&gt;&lt;hr size=&quot;1&quot;/&gt;- impl_ : shared_ptr&lt;TensorImpl&gt;&lt;br&gt;+ shape() / stride() / size(dim) / dim()&lt;br&gt;+ numel() / dtype() / device() / data_ptr()&lt;br&gt;+ operator[] / narrow / transpose / permute&lt;br&gt;+ squeeze / unsqueeze / reshape / contiguous / broadcast&lt;br&gt;+ clone() / copy_() / fill_()&lt;br&gt;+ to(device) / to(dtype)&lt;br&gt;+ requires_grad_() / grad() / detach() / backward()&lt;br&gt;+ Tensor(shape, dtype, device)：唯一调 GetAllocator 处" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=6;spacingTop=2;fontSize=10;fillColor=#dae8fc;strokeColor=#6c8ebf;" parent="1" vertex="1">
                    <mxGeometry x="140" y="90" width="300" height="200" as="geometry"/>
                </mxCell>
                <mxCell id="impl" value="&lt;b style=&quot;font-size:12px&quot;&gt;TensorImpl&lt;/b&gt;&lt;br&gt;&lt;font color=&quot;#666666&quot;&gt;src/tensor/tensor_impl.h&lt;/font&gt;&lt;hr size=&quot;1&quot;/&gt;- storage_ : shared_ptr&lt;Storage&gt;&lt;br&gt;- version_ : VersionCounter&lt;br&gt;- shape_ / stride_ : int64_t[kMaxDim]&lt;br&gt;- storage_offset_ : int64_t，单位是元素&lt;br&gt;- dtype_ : Dtype&lt;br&gt;- autograd_meta_ : shared_ptr&lt;AutogradMetadata&gt;&lt;br&gt;&amp;nbsp;&amp;nbsp;懒创建，头文件里只有前置声明&lt;hr size=&quot;1&quot;/&gt;+ data()：基地址 + offset × itemsize&lt;br&gt;+ numel() / is_contiguous()，结果可缓存&lt;br&gt;+ set_layout(shape, stride, offset)：越界检查&lt;br&gt;+ device()：取自 storage_&lt;br&gt;+ bump_version()" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=6;spacingTop=2;fontSize=10;fillColor=#d5e8d4;strokeColor=#82b366;" parent="1" vertex="1">
                    <mxGeometry x="140" y="620" width="340" height="225" as="geometry"/>
                </mxCell>
                <mxCell id="vcounter" value="&lt;b style=&quot;font-size:12px&quot;&gt;VersionCounter&lt;/b&gt;&lt;br&gt;&lt;font color=&quot;#666666&quot;&gt;src/tensor/tensor_impl.h&lt;/font&gt;&lt;hr size=&quot;1&quot;/&gt;- ref_ : shared_ptr&lt;uint64&gt;&lt;br&gt;+ current() / bump()&lt;br&gt;视图和 detach() 共享同一份" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=6;spacingTop=2;fontSize=10;fillColor=#d5e8d4;strokeColor=#82b366;" parent="1" vertex="1">
                    <mxGeometry x="520" y="640" width="180" height="105" as="geometry"/>
                </mxCell>
                <mxCell id="dtype" value="&lt;b style=&quot;font-size:12px&quot;&gt;Dtype&lt;/b&gt;&lt;br&gt;&lt;font color=&quot;#666666&quot;&gt;include/tensor/dtype.h&lt;/font&gt;&lt;hr size=&quot;1&quot;/&gt;+ dtype_size() / dtype_info()" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=6;spacingTop=2;fontSize=10;fillColor=#dae8fc;strokeColor=#6c8ebf;" parent="1" vertex="1">
                    <mxGeometry x="520" y="780" width="180" height="80" as="geometry"/>
                </mxCell>
                <mxCell id="storage" value="&lt;b style=&quot;font-size:12px&quot;&gt;Storage&lt;/b&gt;&lt;br&gt;&lt;font color=&quot;#666666&quot;&gt;include/tensor/storage.h&lt;/font&gt;&lt;hr size=&quot;1&quot;/&gt;- data_ptr_ : DataPtr&lt;br&gt;- nbytes_ : size_t&lt;hr size=&quot;1&quot;/&gt;+ data() / nbytes() / device()&lt;br&gt;+ 析构只交给 DataPtr 的删除器" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=6;spacingTop=2;fontSize=10;fillColor=#dae8fc;strokeColor=#6c8ebf;" parent="1" vertex="1">
