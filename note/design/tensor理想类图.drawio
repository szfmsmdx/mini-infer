                <mxCell id="band1" value="① 使用者层：对外接口、建图、计算" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=8;spacingTop=2;fontSize=12;fontStyle=1;fontColor=#444444;fillColor=none;strokeColor=#999999;dashed=1;" vertex="1" parent="1">
