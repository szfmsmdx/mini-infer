    <diagram id="tree" name="文件结构树">
        <mxGraphModel dx="400" dy="801" grid="0" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1400" pageHeight="900" math="0" shadow="0">
            <root>
                <mxCell id="0"/>
                <mxCell id="1" parent="0"/>
                <mxCell id="files" value="&lt;b&gt;include/mini_infer/&lt;/b&gt;&lt;br&gt;├── tensor/&amp;nbsp;&amp;nbsp;Tensor 及其基础类型，不依赖上层&lt;br&gt;│&amp;nbsp;&amp;nbsp;├── device.h&amp;nbsp;&amp;nbsp;Device&lt;br&gt;│&amp;nbsp;&amp;nbsp;├── dtype.h&amp;nbsp;&amp;nbsp;Dtype、DtypeInfo、Float16 / BFloat16 编解码&lt;br&gt;│&amp;nbsp;&amp;nbsp;├── scalar.h&amp;nbsp;&amp;nbsp;Scalar&lt;br&gt;│&amp;nbsp;&amp;nbsp;├── allocator.h&amp;nbsp;&amp;nbsp;DataPtr、Allocator 接口&lt;br&gt;│&amp;nbsp;&amp;nbsp;├── storage.h&amp;nbsp;&amp;nbsp;Storage：容量 + DataPtr&lt;br&gt;│&amp;nbsp;&amp;nbsp;└── tensor.h&amp;nbsp;&amp;nbsp;Tensor 句柄、kMaxDim&lt;br&gt;├── autograd.h&amp;nbsp;&amp;nbsp;AutogradMetadata、AutogradNode、开关、RunBackward&lt;br&gt;└── ops/&amp;nbsp;&amp;nbsp;算子公开入口，保持现状&lt;br&gt;&lt;b&gt;src/&lt;/b&gt;&lt;br&gt;├── tensor/&amp;nbsp;&amp;nbsp;不含 CUDA&lt;br&gt;│&amp;nbsp;&amp;nbsp;├── tensor_impl.h&amp;nbsp;&amp;nbsp;TensorImpl、VersionCounter&lt;br&gt;│&amp;nbsp;&amp;nbsp;├── tensor.cpp&amp;nbsp;&amp;nbsp;构造、属性查询、data()&lt;br&gt;│&amp;nbsp;&amp;nbsp;├── layout.cpp&amp;nbsp;&amp;nbsp;视图的 shape / stride / offset 计算&lt;br&gt;│&amp;nbsp;&amp;nbsp;├── check.h / check.cpp&lt;br&gt;│&amp;nbsp;&amp;nbsp;└── print.cpp&lt;br&gt;├── memory/&lt;br&gt;│&amp;nbsp;&amp;nbsp;└── memory.h / memory.cpp&amp;nbsp;&amp;nbsp;GetAllocator、CopyBytes；只有这里出现 cudaMalloc / cudaFree&lt;br&gt;├── cuda/&lt;br&gt;│&amp;nbsp;&amp;nbsp;└── cuda_check.h&amp;nbsp;&amp;nbsp;CUDA_CHECK 宏；以后放设备切换和 stream&lt;br&gt;├── autograd/&lt;br&gt;│&amp;nbsp;&amp;nbsp;└── autograd.cpp&amp;nbsp;&amp;nbsp;拓扑排序、梯度累加&lt;br&gt;└── ops/&amp;nbsp;&amp;nbsp;每类算子一个目录，结构相同&lt;br&gt;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;├── common/&lt;br&gt;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;│&amp;nbsp;&amp;nbsp;└── cuda_layout.h&amp;nbsp;&amp;nbsp;CUDALayout：纯 POD，没有 CUDA 语法&lt;br&gt;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;├── layout/&lt;br&gt;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;│&amp;nbsp;&amp;nbsp;└── nodes.h / nodes.cpp&amp;nbsp;&amp;nbsp;TransposeNode 等视图的反向节点&lt;br&gt;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;└── elementwise/&lt;br&gt;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;├── elementwise.cpp&amp;nbsp;&amp;nbsp;校验、建输出、选后端、挂节点&lt;br&gt;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;├── nodes.h / nodes.cpp&lt;br&gt;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;├── kernels.h&amp;nbsp;&amp;nbsp;入口与后端的私有声明&lt;br&gt;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;├── cpu.cpp&lt;br&gt;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;└── cuda.cu" style="text;html=1;align=left;verticalAlign=top;whiteSpace=wrap;fontFamily=Courier New;fontSize=13;strokeColor=#666666;fillColor=#f5f5f5;spacingLeft=10;spacingTop=6;" parent="1" vertex="1">
                    <mxGeometry x="40" y="40" width="1000" height="620" as="geometry"/>
