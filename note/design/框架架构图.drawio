    <diagram id="dataflow" name="训推一体数据流">
        <mxGraphModel grid="1" page="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" pageScale="1" pageWidth="1680" pageHeight="960" math="0" shadow="0">
            <root>
                <mxCell id="0"/>
                <mxCell id="1" parent="0"/>
                <mxCell id="train_box" value="训练数据流：Eager 前向建图 + 设备无关反向传播" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=10;spacingTop=6;fontSize=13;fontStyle=1;fillColor=#f5f5f5;strokeColor=#82b366;dashed=1;" vertex="1" parent="1">
                    <mxGeometry x="60" y="40" width="1560" height="390" as="geometry"/>
                </mxCell>
                <mxCell id="t1" value="&lt;b&gt;GPT::forward(tokens)&lt;/b&gt;&lt;br&gt;Embedding → N × SimpleDecoderLayer&lt;br&gt;RoPE(pos_offset=0) + causal_attention" style="rounded=1;whiteSpace=wrap;html=1;fontSize=11;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1" parent="1">
                    <mxGeometry x="90" y="95" width="260" height="100" as="geometry"/>
                </mxCell>
                <mxCell id="t2" value="&lt;b&gt;ops 层统一门面&lt;/b&gt;&lt;br&gt;1. Check &amp;amp; 推导形状&lt;br&gt;2. 分配输出 (走 CachingAllocator)&lt;br&gt;3. GetKernelTable().call(device)" style="rounded=1;whiteSpace=wrap;html=1;fontSize=11;fillColor=#e1d5e7;strokeColor=#9673a6;" vertex="1" parent="1">
                    <mxGeometry x="410" y="95" width="270" height="100" as="geometry"/>
                </mxCell>
                <mxCell id="t3" value="&lt;b&gt;前向纯内核&lt;/b&gt;&lt;br&gt;CPU / CUDA Kernel&lt;br&gt;(接收 DeviceContext&amp;amp;)" style="rounded=1;whiteSpace=wrap;html=1;fontSize=11;fillColor=#f8cecc;strokeColor=#b85450;" vertex="1" parent="1">
                    <mxGeometry x="740" y="95" width="220" height="100" as="geometry"/>
                </mxCell>
                <mxCell id="t4" value="&lt;b&gt;ShouldRecordGrad 剪枝&lt;/b&gt;&lt;br&gt;EnableGrad &amp;amp;&amp;amp; Float &amp;amp;&amp;amp; AnyNeedsGrad&lt;br&gt;创建 Node + SavedTensor(记录版本)" style="rounded=1;whiteSpace=wrap;html=1;fontSize=11;fillColor=#ffe6cc;strokeColor=#d79b00;" vertex="1" parent="1">
                    <mxGeometry x="1020" y="95" width="270" height="100" as="geometry"/>
                </mxCell>
                <mxCell id="t5" value="&lt;b&gt;loss.backward()&lt;/b&gt;&lt;br&gt;TopoSort → NoGradGuard&lt;br&gt;Node::backward() 调纯反向算子&lt;br&gt;→ Adam::step() 更新权重" style="rounded=1;whiteSpace=wrap;html=1;fontSize=11;fillColor=#d5e8d4;strokeColor=#82b366;" vertex="1" parent="1">
                    <mxGeometry x="1340" y="95" width="250" height="100" as="geometry"/>
                </mxCell>
                <mxCell id="t6" value="&lt;b&gt;反向纯内核 (与前向对称)&lt;/b&gt;&lt;br&gt;SavedTensor::unpack() 校验版本 → GetKernelTable().*_backward.call(device) → 返回输入梯度" style="rounded=1;whiteSpace=wrap;html=1;fontSize=11;fillColor=#f8cecc;strokeColor=#b85450;" vertex="1" parent="1">
                    <mxGeometry x="740" y="270" width="850" height="90" as="geometry"/>
                </mxCell>

                <mxCell id="infer_box" value="推理数据流：NoGradGuard + KVCache + Prefill / Decode 分阶段增量生成" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=10;spacingTop=6;fontSize=13;fontStyle=1;fillColor=#f5f5f5;strokeColor=#d6b656;dashed=1;" vertex="1" parent="1">
                    <mxGeometry x="60" y="470" width="1560" height="390" as="geometry"/>
                </mxCell>
                <mxCell id="i1" value="&lt;b&gt;推理初始化&lt;/b&gt;&lt;br&gt;NoGradGuard + KVCache(layers, max_seq, channels)&lt;br&gt;复用同一份 GPT 参数与权重" style="rounded=1;whiteSpace=wrap;html=1;fontSize=11;fillColor=#fff2cc;strokeColor=#d6b656;" vertex="1" parent="1">
                    <mxGeometry x="90" y="535" width="310" height="100" as="geometry"/>
                </mxCell>
                <mxCell id="i2" value="&lt;b&gt;Prefill 阶段&lt;/b&gt;&lt;br&gt;输入 prompt [T_p]&lt;br&gt;past_len = 0, RoPE(pos_offset=0)&lt;br&gt;写入 KVCache[0..T_p)" style="rounded=1;whiteSpace=wrap;html=1;fontSize=11;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1" parent="1">
                    <mxGeometry x="450" y="535" width="270" height="100" as="geometry"/>
                </mxCell>
                <mxCell id="i3" value="&lt;b&gt;Decode 循环&lt;/b&gt;&lt;br&gt;输入单个新 token [1]&lt;br&gt;past_len = kv.length(), RoPE(pos_offset=past_len)&lt;br&gt;追加写入 KVCache[past_len]" style="rounded=1;whiteSpace=wrap;html=1;fontSize=11;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1" parent="1">
                    <mxGeometry x="770" y="535" width="320" height="100" as="geometry"/>
                </mxCell>
                <mxCell id="i4" value="&lt;b&gt;cached_attention&lt;/b&gt;&lt;br&gt;Q[T_new, C] 对齐 K/V_cache[0..total_len, C]&lt;br&gt;走 KernelTable.cached_attention (CPU/CUDA)" style="rounded=1;whiteSpace=wrap;html=1;fontSize=11;fillColor=#f8cecc;strokeColor=#b85450;" vertex="1" parent="1">
                    <mxGeometry x="450" y="700" width="640" height="90" as="geometry"/>
                </mxCell>
                <mxCell id="i5" value="&lt;b&gt;Sampler 采样与输出&lt;/b&gt;&lt;br&gt;取末位 logits → Temperature / Greedy / Categorical&lt;br&gt;生成下一 token，释放临时 Tensor 归还 CUDACachingAllocator" style="rounded=1;whiteSpace=wrap;html=1;fontSize=11;fillColor=#fff2cc;strokeColor=#d6b656;" vertex="1" parent="1">
                    <mxGeometry x="1150" y="535" width="440" height="160" as="geometry"/>
                </mxCell>

